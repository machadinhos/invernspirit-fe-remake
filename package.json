{
  "name": "invernspirit-fe",
  "description": "The frontend for the InvernSpirit e-commerce website (https://www.invernspirit.com), built with SvelteKit.",
  "private": true,
  "repository": "https://github.com/machadinhos/invernspirit-fe.git",
  "type": "module",
  "packageManager": "bun@1.3.0",
  "scripts": {
    "dev": "vite dev",
    "local": "bunx wrangler pages dev functions --show-interactive-dev-session=false --port=9000 --compatibility-date=2025-09-22",
    "dev:local": "concurrently --kill-others-on-fail --names \"dev,local\" --prefix-colors \"red,blue\" \"bun run dev\" \"bun run local\"",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "build:preview": "vite build && bun run preview",
    "preview:local": "concurrently --kill-others-on-fail --names \"preview,local\" --prefix-colors \"red,blue\" \"bun run preview\" \"bun run local\"",
    "build:preview:local": "bun run build && bun run preview:local",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint --fix",
    "lint:no-fix": "eslint --concurrency=auto",
    "format": "prettier --write --list-different",
    "format:lint": "prettier --write --list-different . && eslint --fix",
    "a11y-audit": "bun scripts/run-a11y-audit.ts",
    "generate-sitemap": "bun scripts/generate-sitemap.ts",
    "prepare": "(svelte-kit sync || echo '') ; (husky || echo '')"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "dompurify": "^3.3.3",
    "embla-carousel-svelte": "^8.6.0",
    "svelte": "^5.53.12",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "vite-plugin-devtools-json": "^1.0.0",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.11.1",
    "@cloudflare/workers-types": "^4.20260313.1",
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.10",
    "@types/cloudflare-turnstile": "^0.2.2",
    "@types/gtag.js": "^0.0.20",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-svelte": "^3.15.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "ignore": "^7.0.5",
    "prettier": "^3.8.1",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "puppeteer": "^24.39.1",
    "svelte-check": "^4.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
